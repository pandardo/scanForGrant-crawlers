# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase service-role key — bypasses RLS. The crawler is the only writer of
# grants/scan_runs/page_snapshots. Store as a GitHub Actions repository secret.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI-compatible endpoint for the LLM provider (DeepSeek by default).
LLM_BASE_URL=https://api.deepseek.com/v1

# Model name at that endpoint.
LLM_MODEL=deepseek-chat

# API key for the endpoint above.
DEEPSEEK_API_KEY=

# Max LLM calls per run — cost guardrail (ARCHITECTURE.md §6.3).
LLM_MAX_CALLS_PER_RUN=200

# Resend API key for notification emails (Phase 5).
RESEND_API_KEY=

# From-address for notification emails, e.g. alerts@yourdomain.it (Phase 5).
RESEND_FROM=
